# Токен бота MAX (выдаётся в кабинете MAX для бизнеса). Обязателен.
BOT_TOKEN=
# polling — бот сам забирает апдейты через GET /updates (не нужен публичный домен);
# webhook — MAX присылает апдейты на PUBLIC_URL/max/webhook (нужен HTTPS на 443).
UPDATES_MODE=polling
# Публичный HTTPS-адрес сервиса (например, туннель CloudPub): https://xxx.cloudpub.ru
PUBLIC_URL=
# Секрет вебхука, 5–256 символов [A-Za-z0-9_-]. Обязателен при UPDATES_MODE=webhook.
WEBHOOK_SECRET=
# Токен CloudPub (только для профиля tunnel): https://cloudpub.ru → личный кабинет
CLOUDPUB_TOKEN=
# native — кнопки бота открывают мини-приложение MAX (URL прописан в настройках бота);
# link — запасной вход: ссылка на PUBLIC_URL/app/ с подписанным токеном (пока URL не прописан).
WEBAPP_OPEN_MODE=native
# Параметры PostgreSQL для docker compose
POSTGRES_USER=hire
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hire
# Порт, на котором api доступен на хосте
API_PORT=8080
LOG_LEVEL=INFO
