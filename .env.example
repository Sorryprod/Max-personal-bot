# Скопируйте в .env и заполните. В репозитории не должно быть реальных значений.

# --- MAX ---
# Токен бота MAX (выдаётся в кабинете MAX для бизнеса / организаторами). Обязателен.
BOT_TOKEN=
# Ник бота для ссылок-приглашений. Пусто — берётся из GET /me при старте.
BOT_USERNAME=

# --- Получение апдейтов ---
# polling — бот сам забирает апдейты через GET /updates (публичный адрес не нужен);
# webhook — MAX присылает апдейты на PUBLIC_URL/max/webhook (нужен HTTPS на порту 443).
UPDATES_MODE=polling
# Публичный HTTPS-адрес сервиса без слеша в конце, например https://xxx.cloudpub.ru
# Нужен для webhook, для мини-приложения и для WEBAPP_OPEN_MODE=link.
PUBLIC_URL=
# Секрет вебхука, 5–256 символов [A-Za-z0-9_-]. Обязателен при UPDATES_MODE=webhook.
WEBHOOK_SECRET=

# --- Мини-приложение ---
# native — кнопки бота открывают мини-приложение MAX (URL PUBLIC_URL/app/ прописан в настройках бота);
# link   — запасной вход: ссылка на PUBLIC_URL/app/ с подписанным токеном (пока URL не прописан).
WEBAPP_OPEN_MODE=native
# Срок действия подписи initData и токена запасного входа, секунды.
INIT_DATA_TTL_SECONDS=86400
LOGIN_LINK_TTL_SECONDS=86400

# --- Предметная область ---
# Часовой пояс, в котором работодатель задаёт и кандидат видит время собеседования.
APP_TIMEZONE=Europe/Moscow
# Загружать синтетические демо-вакансии и кандидатов при старте (идемпотентно): true/false.
SEED_DEMO=true

# --- Инфраструктура ---
# Параметры PostgreSQL для docker compose (DATABASE_URL для api собирается из них в compose.yaml).
POSTGRES_USER=hire
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hire
# Порт api на хосте.
API_PORT=8080
LOG_LEVEL=INFO
# Токен CloudPub — только для необязательного профиля tunnel (HTTPS-туннель к локальному api).
CLOUDPUB_TOKEN=
